{
  "name": "@multi-game-engines/ui-vue-monitor",
  "version": "0.2.3",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "description": "Engine monitoring and management components for Vue 3",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist --composite false && node ../../scripts/fix-vue-declaration-imports.mjs dist",
    "dev": "vite build --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright-ct.config.ts",
    "test:e2e:install": "playwright install chromium --with-deps",
    "typecheck": "vue-tsc --noEmit"
  },
  "license": "MIT",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@multi-game-engines/core": "workspace:*",
    "@multi-game-engines/i18n-common": "workspace:*",
    "@multi-game-engines/ui-core": "workspace:*",
    "@multi-game-engines/ui-vue-core": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-vue": "^1.62.1",
    "@storybook/vue3": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@types/node": "^25.9.7",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "author": "hdkz-dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdkz-dev/multi-game-engines.git",
    "directory": "packages/ui-vue-monitor"
  },
  "bugs": {
    "url": "https://github.com/hdkz-dev/multi-game-engines/issues"
  },
  "homepage": "https://github.com/hdkz-dev/multi-game-engines#readme",
  "engines": {
    "node": ">=24.0.0"
  }
}
