    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@multi-game-engines/eslint-config-react": "workspace:*",
    "@playwright/experimental-ct-react": "^1.62.1",
    "@storybook/react": "^10.6.4",
