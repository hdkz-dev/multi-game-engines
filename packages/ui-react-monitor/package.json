    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@multi-game-engines/eslint-config-react": "workspace:*",
