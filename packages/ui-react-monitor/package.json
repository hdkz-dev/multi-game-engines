{
  "name": "@multi-game-engines/ui-react-monitor",
  "version": "0.2.8",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "description": "Engine monitoring and management components for React",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright-ct.config.ts",
    "test:e2e:install": "playwright install chromium --with-deps",
    "typecheck": "tsc --noEmit"
