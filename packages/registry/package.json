{
  "name": "@multi-game-engines/registry",
  "version": "1.1.5",
  "description": "Centralized engine metadata registry for multi-game-engines",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "license": "MIT",
  "devDependencies": {
    "@multi-game-engines/core": "workspace:*",
    "stockfish": "^19.0.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@multi-game-engines/core": "workspace:*"
  },
  "dependencies": {
    "@multi-game-engines/i18n-engines": "workspace:*",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
