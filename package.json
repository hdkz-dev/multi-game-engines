{
  "name": "multi-game-engines",
  "private": true,
  "type": "module",
  "description": "A bridge library for various game engines with a plugin-based architecture.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hdkz-dev/multi-game-engines.git"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "infrastructure/cdn/cloudflare"
  ],
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "pnpm -r --if-present test && pnpm test:tooling",
    "test:e2e": "turbo test:e2e",
    "dev": "turbo dev",
    "dev:dashboard": "npx portless dashboard",
    "dev:vue-dashboard": "npx portless vue-dashboard",
    "dev:registry": "npx portless registry",
    "dev:all": "npx portless",
    "lint": "turbo lint && pnpm lint:a11y && pnpm lint:tooling",
    "lint:fix": "turbo lint -- --fix",
    "typecheck": "turbo typecheck",
    "sri:refresh": "node scripts/refresh-engine-sris.mjs",
    "build": "pnpm sri:refresh && turbo build",
    "clean": "find . -type d \\( -name \"dist\" -o -name \".next\" -o -name \".output\" -o -name \".nuxt\" -o -name \"storybook-static\" \\) -not -path \"*/node_modules/*\" -exec rm -rf {} +",
    "clean:deps": "rm -rf node_modules **/node_modules pnpm-lock.yaml",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mcp:mask": "node scripts/sync-mcp-tokens.js mask",
    "mcp:fill": "node scripts/sync-mcp-tokens.js fill",
    "doc-sync": "node scripts/doc-sync.js",
    "prepare": "husky",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "ai:check": "pnpm sri:refresh && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm test:e2e",
    "ai:release": "changeset",
    "npm:setup-oidc": "node scripts/setup-trusted-publishers.mjs",
    "npm:initial-publish": "node scripts/initial-publish.mjs",
    "docs": "npx typedoc",
    "docs:check": "npx typedoc --treatWarningsAsErrors",
    "lint:a11y": "oxlint --config .oxlintrc.json --deny-warnings packages examples",
    "test:tooling": "node --test scripts/validation.test.mjs scripts/tooling-security.test.mjs",
    "lint:tooling": "eslint --no-ignore scripts/doc-sync.js scripts/refresh-engine-sris.mjs scripts/fix-vue-declaration-imports.mjs scripts/validation.test.mjs --max-warnings 0 .pnpmfile.cjs scripts/tooling-security.test.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "stockfish",
      "unrs-resolver",
      "workerd",
      "protobufjs"
    ],
    "overrides": {
      "sharp@<0.35.5": ">=0.35.5 <0.36",
      "simple-git@<4.0.1": ">=4.0.1 <5",
      "@simple-git/argv-parser@<2.0.1": ">=2.0.1 <3",
      "source-map-js@<1.2.2": ">=1.2.2 <2",
      "eslint-plugin-tsdoc>@typescript-eslint/utils": "^8.70.0",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3 <11",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0 <9",
      "lodash@<=4.17.23": ">=4.18.0 <5",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1 <0.29",
      "nitropack>archiver": "^8.0.0"
    },
    "patchedDependencies": {
      "tsup@8.5.1": "patches/tsup@8.5.1.patch",
      "rapid-draughts@1.0.6": "patches/rapid-draughts@1.0.6.patch",
      "@testing-library/jest-dom@7.0.1": "patches/@testing-library__jest-dom@7.0.1.patch",
      "nitropack@2.13.4": "patches/nitropack@2.13.4.patch",
      "@storybook/vue3@10.6.1": "patches/@storybook__vue3@10.6.1.patch",
      "@storybook/react@10.6.1": "patches/@storybook__react@10.6.1.patch",
      "@storybook/react-vite@10.6.1": "patches/@storybook__react-vite@10.6.1.patch",
      "storybook@10.6.1": "patches/storybook@10.6.1.patch",
      "@storybook/web-components@10.6.1": "patches/@storybook__web-components@10.6.1.patch",
      "listhen@1.10.1": "patches/listhen@1.10.1.patch",
      "@next/eslint-plugin-next@16.3.8": "patches/@next__eslint-plugin-next@16.3.8.patch",
      "fast-glob@3.3.3": "patches/fast-glob@3.3.3.patch",
      "globby@16.2.4": "patches/globby@16.2.4.patch",
      "@parcel/watcher@2.5.1": "patches/@parcel__watcher@2.5.1.patch",
      "@nuxt/devtools@3.4.2": "patches/@nuxt__devtools@3.4.2.patch"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.7",
    "@types/pug": "^2.0.10",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-wc": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.87.0",
    "portless": "^0.15.7",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
